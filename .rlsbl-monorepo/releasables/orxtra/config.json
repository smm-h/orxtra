{
  "batch_limits": {
    "exclusions": [
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 1
          }
        ]
      },
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 26
          }
        ]
      }
    ]
  },
  "private": false,
  "targets": [
    "pypi"
  ],
  "pipelines": {
    "pypi": {
      "type": "pypi",
      "local": false
    }
  },
  "coverage_unit": "commit",
  "publish_gate_check_regex": "^(test \\(3\\.\\d+\\)|lint|mypy|import-check|dep-declarations|layer-docs|schema-codegen)$"
}
